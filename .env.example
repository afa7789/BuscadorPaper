# research-graph — API keys (NEVER commit real values; copy to .env and fill)

# LLM (OpenAI-compatible Chat Completions endpoint)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-Text-01

# Optional second LLM provider (any OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=

# Academic providers (all have free tiers; polite-pool emails increase rate limits)
OPENALEX_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=

# Tavily: web search with AI. PRIMARY discovery layer for the pipeline.
# Free tier: 1000 requests/month. Without this key the pipeline falls back
# to semantic_scholar/arxiv/openalex. Get a key at https://tavily.com
TAVILY_API_KEY=

# Sci-Hub: optional opt-in for fetching full-text PDFs via DOI.
# Override the mirror list if the default ones are blocked in your region.
# Set `enable_scihub: true` in config.yaml to activate the provider.
SCIHUB_MIRRORS=https://sci-hub.se,https://sci-hub.st,https://sci-hub.ru

# Optional: arXiv rate limit (seconds between requests, default 3)
ARXIV_RATE_LIMIT_SECONDS=3

# Cache location (default: ./cache.sqlite in cwd)
RESEARCH_GRAPH_CACHE_PATH=./cache.sqlite

# Optional: log level override (defaults to config.yaml log_level)
RESEARCH_GRAPH_LOG_LEVEL=INFO
