# research-graph — gitignore for GitHub publication
#
# This file prevents committing secrets, generated artifacts, IDE/editor
# state, and language-tool caches. Keep it aligned with the README's
# "first run" instructions: anything in `.env.example` should NOT be tracked
# here, but the `.env` file the user creates from it must NOT be tracked.

# -----------------------------------------------------------------------------
# Secrets and credentials — NEVER commit
# -----------------------------------------------------------------------------
# Note: a bare ".env" pattern would also match ".env.example" as a prefix,
# defeating the negation below. We anchor with a slash and exclude
# ".example" so only the real secrets are caught. The negation
# "!/.env.example" then un-blocks the template file specifically.
#
# Order matters: negation rules MUST come AFTER the patterns they override.
/.env
/.env.local
/.env.*.local
.envrc
*.pem
*.key
*.token
secrets.*

# Allow the example template to be tracked.
!.env.example

# -----------------------------------------------------------------------------
# Generated artifacts — reproducible from the pipeline
# -----------------------------------------------------------------------------
output/
cache/
cache/scihub/   # downloaded PDFs from Sci-Hub (large, copyrighted)
cache.sqlite
cache.sqlite-journal
cache.sqlite-wal
cache.sqlite-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal

# -----------------------------------------------------------------------------
# Local agent/orchestrator state
# -----------------------------------------------------------------------------
.dagrobin/
.dagrobin.db
.claude/
.claude/

# -----------------------------------------------------------------------------
# Python toolchain
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.spec

# Virtual environments
.venv/
venv/
env/
ENV/

# -----------------------------------------------------------------------------
# Test and lint caches
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.pyright/
.benchmarks/
.tox/
.cache/

# -----------------------------------------------------------------------------
# Type stubs and mypy outputs
# -----------------------------------------------------------------------------
*.mypy.ini
.mypy.ini

# -----------------------------------------------------------------------------
# uv / Python project lock (kept out of repo by default; commit if your
# project is a library that downstream users pin to a specific version)
# -----------------------------------------------------------------------------
uv.lock

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.iml
.project
.classpath
.settings/

# Tooling-specific state
.cursor/
.aider*
.continue/
.cody/
.windsurf/

# -----------------------------------------------------------------------------
# OS-specific
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Build/CI artifacts
# -----------------------------------------------------------------------------
dist/
build/
*.tar.gz
*.whl
*.zip

# -----------------------------------------------------------------------------
# Project-specific: keep .env.example committed but never the real .env
# -----------------------------------------------------------------------------
config.local.yaml
config.local.yml

# -----------------------------------------------------------------------------
# Pyvis assets (generated by pyvis on first graph.html build)
# -----------------------------------------------------------------------------
lib/
